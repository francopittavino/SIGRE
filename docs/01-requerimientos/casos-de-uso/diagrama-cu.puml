@startuml diagrama-cu
' Diagrama general de casos de uso de SIGRE (plantilla 02, sección 4).
' Muestra todos los actores y casos de uso con sus relaciones «include» y
' «extend». Las condiciones de cada «extend» y los puntos de extensión se
' muestran en las vistas por área (diagrama-cu-N-*.puml), para que este
' diagrama siga siendo legible.
' Fuente: 00-inventario.md (actores y relaciones) y las fichas CU-NNN-slug.md.
' Si se agrega, saca o renombra un CU, actualizar primero el inventario, después
' este archivo y la vista que corresponda.
' Generar las imágenes: plantuml -charset UTF-8 -tpng -tsvg diagrama-cu*.puml

!include estilo-cu.iuml
left to right direction

' ---------------------------------------------------------------- actores
' A la izquierda los actores del lado residente; a la derecha el
' administrador y los actores secundarios (las asociaciones se escriben
' "CU -- actor" para que Graphviz los ubique a la derecha).
actor "//Usuario//" as Usuario
actor "//Residente//" as Residente
actor "Propietario" as Propietario
actor "Inquilino" as Inquilino
actor "Administrador" as Admin
actor "Tiempo" as Tiempo
actor "Servicio de IA" as IA
actor "Servicio de Email" as Email

Residente -up-|> Usuario
Propietario -up-|> Residente
Inquilino -up-|> Residente
Admin -up-|> Usuario

' ---------------------------------------------------------------- sistema
rectangle "SIGRE" {

  package "Acceso y cuenta" {
    usecase "CU-001\nIniciar sesión" as CU001
    usecase "CU-002\nRecuperar contraseña" as CU002
    usecase "CU-003\nModificar datos de perfil" as CU003
    usecase "CU-004\nCompletar registro" as CU004
  }

  package "Reclamos del residente" {
    usecase "CU-021\nRegistrar reclamo" as CU021
    usecase "CU-022\nConsultar mis reclamos" as CU022
    usecase "CU-023\nConsultar reclamos comunitarios" as CU023
    usecase "CU-024\nVer detalle de reclamo" as CU024
    usecase "CU-025\nModificar reclamo" as CU025
    usecase "CU-026\nCancelar reclamo" as CU026
    usecase "CU-027\nAdherir a reclamo comunitario" as CU027
    usecase "CU-028\nMarcar reclamo como resuelto" as CU028
  }

  package "Historial y reportes" {
    usecase "CU-034\nConsultar historial de ubicación" as CU034
    usecase "CU-035\nGenerar reporte de reclamos" as CU035
  }

  package "Reclamos del administrador" {
    usecase "CU-030\nConsultar reclamos" as CU030
    usecase "CU-031\nCategorizar reclamo" as CU031
    usecase "CU-032\nCambiar estado de reclamo" as CU032
    usecase "CU-033\nAgregar comentario a reclamo" as CU033
  }

  package "Usuarios" {
    usecase "CU-005\nConsultar usuarios" as CU005
    usecase "CU-006\nInvitar usuario" as CU006
    usecase "CU-007\nModificar usuario" as CU007
    usecase "CU-008\nDar de baja usuario" as CU008
    usecase "CU-039\nReactivar usuario" as CU039
  }

  package "Unidades" {
    usecase "CU-009\nConsultar unidades" as CU009
    usecase "CU-010\nAgregar unidad" as CU010
    usecase "CU-011\nModificar unidad" as CU011
    usecase "CU-012\nDar de baja unidad" as CU012
  }

  package "Ubicaciones compartidas" {
    usecase "CU-013\nConsultar ubicaciones compartidas" as CU013
    usecase "CU-014\nAgregar ubicación compartida" as CU014
    usecase "CU-015\nModificar ubicación compartida" as CU015
    usecase "CU-016\nDar de baja ubicación compartida" as CU016
  }

  package "Rubros" {
    usecase "CU-017\nConsultar rubros" as CU017
    usecase "CU-018\nAgregar rubro" as CU018
    usecase "CU-019\nModificar rubro" as CU019
    usecase "CU-020\nDar de baja rubro" as CU020
  }

  package "Automáticos e incluidos" {
    usecase "CU-036\nCerrar reclamos resueltos\nautomáticamente" as CU036
    usecase "CU-037\nSugerir rubro de reclamo" as CU037
    usecase "CU-038\nEnviar notificación por email" as CU038
  }
}

' ------------------------------------------------- actores principales
' Como en el material de cátedra, el actor se asocia solo al CU base; los CU
' que lo extienden se alcanzan por el «extend» y comparten su actor.
Usuario -- CU001
Usuario -- CU002
Usuario -- CU003
' CU-004 lo ejecuta el residente invitado, que todavía no tiene cuenta.
Residente -- CU004
Residente -- CU021
Residente -- CU022
Residente -- CU023
Propietario -- CU034
Tiempo -- CU036

CU005 -- Admin
CU006 -- Admin
CU009 -- Admin
CU010 -- Admin
CU013 -- Admin
CU014 -- Admin
CU017 -- Admin
CU018 -- Admin
CU030 -- Admin
CU034 -- Admin
CU035 -- Admin

' ------------------------------------------------- actores secundarios
